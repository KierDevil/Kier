<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Kier.Mobile.Views.PaymentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Process Payment" FontSize="28" TextColor="#2563eb" HorizontalOptions="Center" />
            <Label Text="Student ID" />
            <Entry x:Name="StudentIdEntry" Placeholder="Student database ID" Keyboard="Numeric" />
            <Label Text="Amount Paid" />
            <Entry x:Name="AmountPaidEntry" Placeholder="1000.00" Keyboard="Numeric" />
            <Label Text="Collector Name" />
            <Entry x:Name="CollectorNameEntry" Placeholder="Cashier" />
            <Label Text="Receipt Number" />
            <Entry x:Name="ReceiptNumberEntry" Placeholder="RCPT-2026-001" />
            <Label Text="Category" />
            <Entry x:Name="CategoryEntry" Placeholder="Tuition Payment" />
            <Button Text="Submit Payment" Clicked="OnSubmitPaymentClicked" />
            <Label x:Name="PaymentStatusLabel" TextColor="#0f172a" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
