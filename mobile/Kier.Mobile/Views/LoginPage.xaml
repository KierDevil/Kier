<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Kier.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:Kier.Mobile.ViewModels"
    BackgroundColor="White">

    <ContentPage.BindingContext>
        <viewmodels:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Kier Attendance" FontSize="32" TextColor="#2563eb" HorizontalOptions="Center" />
            <Label Text="Server URL" />
            <Entry Text="{Binding ServerUrl}" Placeholder="http://192.168.0.100:5000" Keyboard="Url" />
            <Label Text="Username" />
            <Entry Text="{Binding Username}" Placeholder="admin" />
            <Label Text="Password" />
            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Password" />
            <Button Text="Login" Clicked="OnLoginClicked" />
            <Label Text="{Binding StatusMessage}" TextColor="Red" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
